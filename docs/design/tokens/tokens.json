{
  "color": {
    "ground-base": {
      "light": "#EEF1F8",
      "dark": "#0E1120",
      "use": "Page base under the glows (website); app window wallpaper in mock-ups"
    },
    "ground-glow-blue": {
      "light": "#6E8CFF61",
      "dark": "#6E8CFF42",
      "use": "Radial glow, top left, 900 × 600 px"
    },
    "ground-glow-violet": {
      "light": "#B982FF4C",
      "dark": "#B982FF33",
      "use": "Radial glow, top right, 800 × 600 px"
    },
    "ground-glow-cyan": {
      "light": "#50C8E638",
      "dark": "#50C8E61F",
      "use": "Radial glow, bottom, 1000 × 700 px"
    },
    "surface-panel": {
      "light": "#FFFFFFB8",
      "dark": "#1A1E30B8",
      "use": "Frosted panels and the address strip (blur 24 px)"
    },
    "surface-window": {
      "light": "#FFFFFFD9",
      "dark": "#171A2AE6",
      "use": "Website app window and the Mac app window (blur 30–40 px)"
    },
    "surface-side": {
      "light": "#F1F3FA",
      "dark": "#20243A",
      "use": "Side areas, path lists, notes inside panels"
    },
    "row-hover": {
      "light": "#E6EAF5",
      "dark": "#262B44",
      "use": "Row and button hover, progress track"
    },
    "separator": {
      "light": "#DCE1EE",
      "dark": "#2E3450",
      "use": "Hairlines between rows and sections"
    },
    "text-primary": {
      "light": "#1A1D2B",
      "dark": "#EEF0F8",
      "use": "Headings, app names, body"
    },
    "text-secondary": {
      "light": "#545A6E",
      "dark": "#A3A9BE",
      "use": "Supporting text, counts, captions (6:1 on base)"
    },
    "accent": {
      "light": "#3A5BEF",
      "dark": "#3A5BEF",
      "use": "Primary button fill (with accent-hi gradient), ticked checkbox"
    },
    "accent-hi": {
      "light": "#5F7DFF",
      "dark": "#5F7DFF",
      "use": "Top of the primary button gradient"
    },
    "accent-text": {
      "light": "#3048D6",
      "dark": "#93A6FF",
      "use": "Links, Select all, eyebrow labels"
    },
    "accent-tint": {
      "light": "#E3E8FF",
      "dark": "#252E5E",
      "use": "Ticked row, verifying row, banners"
    },
    "focus-ring": {
      "light": "#3A5BEF",
      "dark": "#93A6FF",
      "use": "3 px keyboard focus outline, 2 px offset"
    },
    "checkbox-edge": {
      "light": "#7E869E",
      "dark": "#5D6480",
      "use": "Square checkbox border at rest. 2.2:1 on white: see ACCESSIBILITY.md, fix A-1"
    },
    "icon-placeholder": {
      "light": "#E1E5F1",
      "dark": "#2A2F48",
      "use": "App icon slot before the real icon loads"
    },
    "success": {
      "light": "#1A7F37",
      "dark": "#3FB950",
      "use": "Done, Installed. Use on window surfaces (5:1 on white), not on the ground (4.49:1)"
    },
    "warning": {
      "light": "#8A5A00",
      "dark": "#E3B341",
      "use": "Waiting in Apple’s Installer, notices"
    },
    "warning-tint": {
      "light": "#FFF4DC",
      "dark": "#3A2F12",
      "use": "Installer row background"
    },
    "danger": {
      "light": "#C4161C",
      "dark": "#FF6B6B",
      "use": "Refused and its reason"
    },
    "danger-tint": {
      "light": "#FDE8E8",
      "dark": "#3D1A1E",
      "use": "Refused row background"
    },
    "destructive": {
      "light": "#D92D2D",
      "dark": "#D92D2D",
      "use": "Uninstall button fill"
    },
    "disabled": {
      "light": "#DCE1EE",
      "dark": "#2E3450",
      "use": "Disabled button fill / label"
    }
  },
  "space": {
    "space-1": 4,
    "space-2": 8,
    "space-3": 12,
    "space-4": 16,
    "space-5": 24,
    "space-6": 32,
    "space-7": 48,
    "space-8": 64,
    "space-9": 96
  },
  "radius": {
    "r-checkbox": "4–5 px",
    "r-row": "7–9 px",
    "r-button": "10–12 px",
    "r-panel": "16–20 px",
    "r-window": "14 px (app mock) / 18 px (site full screen)",
    "r-icon": "22.37%"
  },
  "elevation": {
    "e-window": "0 0 0 1px #DCE1EE, 0 30px 80px rgba(20,30,80,.22)",
    "e-glass": "inset 0 1px 0 rgba(255,255,255,.95), 0 0 0 .5px rgba(20,30,80,.14), 0 2px 6px rgba(20,30,80,.08), 0 20px 50px rgba(20,30,80,.22); fill linear-gradient(180deg, rgba(255,255,255,.78), rgba(244,246,255,.55)); blur 30 px, saturate 200%",
    "e-panel": "0 0 0 1px #DCE1EE, 0 24px 60px rgba(10,15,40,.30)",
    "e-button": "inset 0 1px 0 rgba(255,255,255,.38), inset 0 -1px 0 rgba(0,0,0,.12), 0 6px 18px rgba(58,91,239,.32)",
    "e-dim": "rgba(10,15,40,.22)"
  },
  "type": {
    "web": [
      {
        "name": "display",
        "family": "System font (SF Pro)",
        "size": "clamp(38–62 px)",
        "weight": "800",
        "line": "1.04",
        "use": "Home headline, two lines"
      },
      {
        "name": "page-title",
        "family": "System font",
        "size": "56 px",
        "weight": "800",
        "line": "60 px",
        "use": "Footer page titles"
      },
      {
        "name": "app-title",
        "family": "System font",
        "size": "36 px",
        "weight": "800",
        "line": "42 px",
        "use": "\"Pick the apps for your Mac.\""
      },
      {
        "name": "section",
        "family": "System font",
        "size": "24 px",
        "weight": "700",
        "line": "30 px",
        "use": "Footer page section headings"
      },
      {
        "name": "lede",
        "family": "System font",
        "size": "20 px",
        "weight": "400",
        "line": "30 px",
        "use": "Hero subhead, page intros"
      },
      {
        "name": "body",
        "family": "System font",
        "size": "17 px",
        "weight": "400",
        "line": "27 px",
        "use": "Section text"
      },
      {
        "name": "row",
        "family": "System font",
        "size": "15 px",
        "weight": "500",
        "line": "20 px",
        "use": "App names in the picker"
      },
      {
        "name": "label",
        "family": "System font",
        "size": "13 px",
        "weight": "700",
        "line": "20 px",
        "use": "Category headings, eyebrows (uppercase .06em)"
      },
      {
        "name": "caption",
        "family": "System font",
        "size": "12–13 px",
        "weight": "400–600",
        "line": "18 px",
        "use": "Footer, counts"
      },
      {
        "name": "mono",
        "family": "ui-monospace (SF Mono)",
        "size": "13 px",
        "weight": "400",
        "line": "18 px",
        "use": "Addresses, paths"
      }
    ],
    "app": [
      {
        "name": "window-title",
        "family": "System font",
        "size": "26 pt",
        "weight": "Bold",
        "line": "32 pt",
        "use": "Screen headings (\"Installing 7 apps\")"
      },
      {
        "name": "row-name",
        "family": "System font",
        "size": "15 pt",
        "weight": "Semibold",
        "line": "20 pt",
        "use": "App names"
      },
      {
        "name": "row-detail",
        "family": "System font",
        "size": "13 pt",
        "weight": "Regular",
        "line": "18 pt",
        "use": "Status details, reasons"
      },
      {
        "name": "status",
        "family": "System font",
        "size": "13 pt",
        "weight": "Semibold",
        "line": "18 pt",
        "use": "Done, Refused, Waiting…"
      },
      {
        "name": "section",
        "family": "System font",
        "size": "12 pt",
        "weight": "Bold, uppercase",
        "line": "16 pt",
        "use": "Finished screen groups"
      },
      {
        "name": "button",
        "family": "System font",
        "size": "14 pt",
        "weight": "Semibold",
        "line": "18 pt",
        "use": "Buttons"
      },
      {
        "name": "panel-title",
        "family": "System font",
        "size": "18 pt",
        "weight": "Bold",
        "line": "24 pt",
        "use": "Centred panel titles"
      },
      {
        "name": "path",
        "family": "SF Mono",
        "size": "11.5 pt",
        "weight": "Regular",
        "line": "17 pt",
        "use": "Leftover paths in Uninstall"
      }
    ]
  },
  "motion": [
    {
      "name": "m-hover",
      "duration": "120 ms",
      "easing": "ease-out",
      "use": "Row, link and button hover"
    },
    {
      "name": "m-tick",
      "duration": "160 ms",
      "easing": "cubic-bezier(.2,.8,.2,1)",
      "use": "Checkbox fill and row tint"
    },
    {
      "name": "m-press",
      "duration": "220 ms",
      "easing": "cubic-bezier(.22,1,.36,1)",
      "use": "Button press: scale .94"
    },
    {
      "name": "m-pane",
      "duration": "450 ms opacity / 650 ms move",
      "easing": "ease / cubic-bezier(.22,1,.36,1)",
      "use": "Demo screens crossfade and rise 16 px"
    },
    {
      "name": "m-step",
      "duration": "600 ms",
      "easing": "cubic-bezier(.22,1,.36,1)",
      "use": "Hero step highlight slides"
    },
    {
      "name": "m-pop",
      "duration": "320 ms",
      "easing": "cubic-bezier(.34,1.4,.64,1)",
      "use": "Icons dropping into the bar"
    },
    {
      "name": "m-bar",
      "duration": "850–900 ms",
      "easing": "cubic-bezier(.4,0,.2,1)",
      "use": "Download progress fill"
    },
    {
      "name": "m-icon-once",
      "duration": "900 ms per tile, 0 / 120 / 240 ms delays",
      "easing": "cubic-bezier(.34,1.45,.64,1)",
      "use": "App icon plays once: tiles from scale .25 in the box opening to place"
    },
    {
      "name": "m-icon-loop",
      "duration": "3.2 s loop",
      "easing": "cubic-bezier(.34,1.45,.64,1)",
      "use": "Icon loop (brand board only): out by 34%, hold to 82%, back in by 96%"
    },
    {
      "name": "m-demo",
      "duration": "450 ms per frame, 33 frames",
      "easing": "steps",
      "use": "Hero demo: 0–8 choose, 9–24 verify, 25–32 uninstall"
    },
    {
      "name": "m-scroll",
      "duration": "follows scroll, eased 0.2 per frame",
      "easing": "easeInOutCubic over 60% of the scroll",
      "use": "Hero window zooms to full screen; picker fades in over the first 12%"
    }
  ],
  "_note": "Light ships. Dark is reserved and must not be wired up yet (DECISIONS.md #4, #16, #27)."
}