  "notes": {
    "fwTitle": {
      "x": 0,
      "y": -300,
      "text": "SettleIn design framework",
      "kind": "title1",
      "maxW": 1440,
      "page": "framework"
    },
    "webTitle": {
      "x": 0,
      "y": -300,
      "text": "Website (light only)",
      "kind": "title1",
      "maxW": 4480,
      "page": "website"
    },
    "q4": {
      "x": 1520,
      "y": 1420,
      "w": 440,
      "size": "m",
      "fill": "orange",
      "page": "website",
      "text": "PROPOSAL, open question 4. A link that names an app the catalog no longer holds still opens cleanly: known apps are ticked, and a quiet one-line notice says how many were left out, with a Dismiss button. No error state. Owner decides; the alternative is to ignore it silently as the spec says today."
    },
    "q2": {
      "x": 3040,
      "y": 1420,
      "w": 440,
      "size": "m",
      "fill": "orange",
      "page": "website",
      "text": "PROPOSAL, open question 2. W3 is one simple page: the download has started, how to open it, the apps that travel with it, and Change selection or Download again. The page can't tell whether SettleIn is already installed, so one quiet line covers that case (it opens by itself; the browser may ask to Allow)."
    },
    "dock": {
      "x": 0,
      "y": 1420,
      "w": 440,
      "size": "m",
      "fill": "blue",
      "page": "website",
      "text": "Scroll story: the hero window plays the demo on a loop (Choose, Verify, Uninstall); its floating selection bar shows only during Choose. Scrolling down, it crossfades into the live picker and zooms to fill the screen, leaving 20 px around it so it still reads as an app. A 'Your turn' header tells you what to do; the floating glossy bar holds the count and Download SettleIn. Open full window to scroll."
    },
    "filters": {
      "x": 480,
      "y": 1420,
      "w": 440,
      "size": "m",
      "fill": "blue",
      "page": "website",
      "text": "No category sidebar: all 44 apps sit in five columns under their category headings. Rows and icons size to the screen height so the list fills the app above the floating bar."
    },
    "github": {
      "x": 960,
      "y": 1420,
      "w": 440,
      "size": "m",
      "fill": "orange",
      "page": "website",
      "text": "GitHub mark: the header and footer use GitHub's official mark from their Octicons package (MIT licensed), as GitHub allows for linking to a GitHub repository. Footer: brand line, Star on GitHub, three link columns (SettleIn, Open source, Trust) and a line saying SettleIn is not affiliated with Apple."
    },
    "brandTitle": {
      "x": 0,
      "y": -300,
      "text": "SettleIn brand",
      "kind": "title1",
      "maxW": 3300,
      "page": "brand"
    },
    "lightOnly": {
      "x": 3520,
      "y": 1420,
      "w": 440,
      "size": "m",
      "fill": "orange",
      "page": "website",
      "text": "OWNER DECISION: the website is light only. This replaces spec claim C10 (follow the system light or dark appearance); update the spec and DESIGN.md to match. The Mac app still follows the system appearance."
    },
    "footTitle": {
      "x": 0,
      "y": 2200,
      "text": "Footer pages",
      "kind": "title1",
      "maxW": 6000,
      "page": "website"
    },
    "placeholders": {
      "x": 0,
      "y": 4900,
      "w": 440,
      "size": "m",
      "fill": "orange",
      "page": "website",
      "text": "Placeholders to fill in: [VERSION] and [RELEASE DATE] on Release notes, and every GitHub link (#). 'Suggest an app' in the footer goes straight to an outside form (Google Forms or similar); add its address when it exists."
    },
    "mobTitle": {
      "x": 0,
      "y": -300,
      "text": "Mobile",
      "kind": "title1",
      "maxW": 2270,
      "page": "mobile"
    },
    "mobNote": {
      "x": 2275,
      "y": 0,
      "w": 440,
      "size": "m",
      "fill": "blue",
      "page": "mobile",
      "text": "You can't download a Mac app on a phone, so mobile is about saving the list. The hero shows the animated icon instead of the demo window, the picker is one column with category Select all, and the floating bar offers Copy link instead of Download. The link opens the same ticked list on a Mac."
    },
    "relNote": {
      "x": 6080,
      "y": 2500,
      "w": 440,
      "size": "m",
      "fill": "blue",
      "page": "website",
      "text": "Release notes are one timeline with three kinds of entry. App update: a new SettleIn version (New, Improved, Fixed, Security); it also shows in Sparkle's update window. Catalog change: apps added, removed or changed on settlein.dev; reaches people without an app update. Notice: something people should know now, such as an app paused after failing a check. Tabs filter the timeline; RSS lets people follow it."
    },
