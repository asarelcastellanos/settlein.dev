---
import { REPO_URL, ISSUES_URL, SUGGEST_AN_APP_FORM_URL } from "../lib/site.js";

const columns = [
  {
    name: "SettleIn",
    links: [{ label: "Release notes", href: "/release-notes" }],
  },
  {
    name: "Open source",
    links: [
      { label: "Source code", href: REPO_URL, note: "opens GitHub" },
      { label: "Report a problem", href: ISSUES_URL, note: "opens GitHub" },
      { label: "Suggest an app", href: SUGGEST_AN_APP_FORM_URL, note: "opens in a new tab" },
    ],
  },
  {
    name: "Trust",
    links: [
      { label: "How apps are verified", href: "/how-apps-are-verified" },
      { label: "What SettleIn sends", href: "/what-settlein-sends" },
    ],
  },
];
---

<footer class="site-foot">
  <div class="foot-main">
    <div class="foot-brand">
      <a class="foot-logo" href="/">
        <img src="/settlein-icon.svg" width="28" height="28" alt="" />
        <span>SettleIn</span>
      </a>
      <p>Sets up your new Mac in one go. Free and open source.</p>
      <a class="foot-star" href={REPO_URL} target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"
          ><path
            d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
          ></path></svg
        >
        <span>Star SettleIn on GitHub<span class="sr-only"> (opens GitHub)</span></span>
        <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
          ><path d="M5 2.5h8.5V11M13.5 2.5 2.5 13.5"></path></svg
        >
      </a>
    </div>
    <div class="foot-cols">
      {
        columns.map((column) => (
          <nav aria-label={column.name}>
            <p class="foot-col-name">{column.name}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  {link.note ? (
                    <a href={link.href} target="_blank" rel="noopener">
                      <span>
                        {link.label}
                        <span class="sr-only"> ({link.note})</span>
                      </span>
                      <svg width="11" height="11" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 2.5h8.5V11M13.5 2.5 2.5 13.5" />
                      </svg>
                    </a>
                  ) : (
                    <a href={link.href}>{link.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>
  <div class="foot-base">
    <p>© 2026 SettleIn contributors</p>
    <p>Not affiliated with Apple. App names and icons belong to their owners.</p>
  </div>
</footer>
